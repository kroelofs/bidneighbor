{
  "name": "bidneighbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BidNeighbor.com — local service-request marketplace on Cloudflare",
  "scripts": {
    "dev:web": "vite",
    "dev:cloud": "wrangler dev --config cloud/wrangler.toml",
    "build:web": "vite build",
    "build": "npm run build:web",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cloud/worker/tsconfig.json",
    "test": "vitest run",
    "seed:remote": "wrangler d1 execute bidneighbor --remote --config cloud/wrangler.toml --file cloud/d1/seed.sql",
    "seed:local": "wrangler d1 execute bidneighbor --local --config cloud/wrangler.toml --file cloud/d1/seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wrangler": "^3.80.0"
  }
}
