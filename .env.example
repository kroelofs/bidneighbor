# BidNeighbor.com — local tooling env (gitignored copy lives at .env)
# Cloudflare account: kyle@steadycalls.com

# --- GitHub ---
github_token=ghp_xxx
github_profile_url=https://github.com/kroelofs
github_user=kroelofs

# --- Cloudflare ---
cloudflare_account_id=xxx
cloudflare_api_token=xxx

# --- AI providers (optional; future AI features only) ---
open_router_api_key=sk-or-v1-xxx
claude_api_key=sk-ant-api03-xxx
open_ai_api_key=sk-proj-xxx

# --- Worker runtime secrets (set via `wrangler secret put`, NOT committed) ---
# TURNSTILE_SECRET_KEY=xxx
# EMAIL_API_KEY=re_xxx                 # Resend API key (transactional email)
# EMAIL_FROM=no-reply@bidneighbor.com
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxx
# SESSION_SIGNING_KEY=xxx              # random 32+ byte secret for signing session cookies
# APP_BASE_URL=https://app.bidneighbor.com
# ADMIN_BASE_URL=https://admin.bidneighbor.com
